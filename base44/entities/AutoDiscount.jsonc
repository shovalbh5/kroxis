{
  "name": "AutoDiscount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Discount rule name"
    },
    "min_order_amount": {
      "type": "number",
      "description": "Minimum cart total to trigger"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed_amount",
        "free_shipping"
      ],
      "description": "Type of automatic discount"
    },
    "discount_value": {
      "type": "number",
      "description": "Discount value"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Higher priority wins when multiple rules match"
    }
  },
  "required": [
    "name",
    "min_order_amount",
    "discount_type",
    "discount_value"
  ]
}